# Copia a .env.local para cambiar valores en tu máquina (no se sube al repositorio).
# URL de la consola Angular (enlace del menú lateral para los módulos no migrados).
VITE_CONSOLA_ANGULAR_URL=http://localhost:4200
# Zona del backend (APP_ZONA_HORARIA). Las fechas sin zona (creadoEn, actualizadoEn) se leen en ella.
VITE_ZONA_NEGOCIO=America/Lima
