# ============================================================
# Plantilla de variables de entorno del backend.
# Copiala a ".env" (ese archivo NO se sube al repositorio) y completa los
# valores. En Render las mismas variables se definen en el dashboard.
# ============================================================

# Puerto PUBLICO del contenedor (lo sirve nginx). Render inyecta PORT (10000).
PORT=10000

# Puerto del backend Java. Debe ser DISTINTO de PORT. Sin Docker, junto a
# Angular, es el que espera environment.development.ts.
BACKEND_PORT=2003

# --- Base de datos PostgreSQL: conexiones multiples -----------------
# Declara uno o varios bloques DB_<NOMBRE>_* y elige el activo con
# DB_CONEXION. Cada bloque acepta host/puerto/base/usuario/clave o, en su
# lugar, una sola DB_<NOMBRE>_URL=postgresql://usuario:clave@host:5432/base.
DB_CONEXION=NUBE

# NUBE (Render)
DB_NUBE_HOST=
DB_NUBE_PORT=5432
DB_NUBE_NAME=
DB_NUBE_USER=
DB_NUBE_PASSWORD=
# disable | require | verify-full (valida el certificado: usalo fuera de Render)
DB_NUBE_SSLMODE=verify-full
# Pool fijo por instancia (por defecto 20) y tiempo maximo por sentencia (ms).
#DB_NUBE_POOL=20
#DB_NUBE_STATEMENT_TIMEOUT_MS=15000

# LOCAL (opcional): para usarlo, DB_CONEXION=LOCAL
#DB_LOCAL_HOST=localhost
#DB_LOCAL_PORT=5432
#DB_LOCAL_NAME=configuration
#DB_LOCAL_USER=postgres
#DB_LOCAL_PASSWORD=
#DB_LOCAL_SSLMODE=disable

# --- Usuario administrador semilla (se crea al arrancar si no existe) ---
USER_ADMIN=@admin
USER_PASSWORD=
USER_NAME=
USER_LASTNAME=
USER_EMAIL=
USER_PHONE=
USER_ACTIVO=TRUE
USER_ROL=ADMINISTRADOR

# --- Firma JWT (minimo 32 bytes): openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=farmacias-peruanas
# Vida del access token en ms (opcional, por defecto 900000 = 15 min).
#JWT_EXPIRATION_MS=900000

# --- CORS: origenes del frontend (separados por comas) ---
# Solo hace falta si el SPA se sirve desde otro dominio que la API.
CORS_ALLOWED_ORIGINS=http://localhost:4200


