# ============================================================
# Plantilla de variables de entorno del backend.
# Copiala a ".env" (esta version NO se sube al repositorio) y
# completa los valores. Tambien puedes definir estas variables
# directamente en el entorno (Render las inyecta asi).
# ============================================================

# Puerto PUBLICO del contenedor (lo sirve nginx). Render inyecta PORT (10000).
PORT=10000

# Puerto del backend Java. Debe ser DISTINTO de PORT.
# Al correr el backend directo (sin Docker) junto a Angular, este es el
# puerto que usa (2003, el que espera environment.development.ts).
BACKEND_PORT=2003

# --- Base de datos: elige UN entorno (comenta el bloque que NO uses) ---

# MySQL LOCAL (pruebas)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=cambia-esta-clave
DB_NAME=hehiachi_mishima
DB_PARAMS=useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# --- Usuario administrador semilla (se crea al arrancar si no existe) ---
USER_ADMIN=@admin
USER_PASSWORD=cambia-esta-clave
USER_NAME=Jhostin
USER_LASTNAME=Alvarez
USER_EMAIL=admin@farmaciasperuanas.pe
USER_PHONE=902044601
USER_ACTIVO=TRUE
USER_ROL=Administrador

# --- Firma JWT (minimo 32 caracteres). Genera una nueva con:
#     openssl rand -hex 32
JWT_SECRET=cambia-esta-clave-jwt
JWT_ISSUER=farmacias-peruanas

# --- CORS: origenes del frontend (separados por comas) ---
# En local, Angular corre en http://localhost:4200.
# En produccion, agrega el dominio real, p. ej.
#   https://app.farmaciasperuanas.pe,https://farmacias-peruanas-web.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Opcionales (valores por defecto entre parentesis) ---
# Perfil de produccion: logs JSON, apagado ordenado, pool pequeno.
# SPRING_PROFILES_ACTIVE=prod
# Pool de conexiones (25 en local, 5 en prod) y minimo inactivo.
# DB_POOL_MAX=5
# DB_POOL_MIN=1
# Coste BCrypt (10). Cada +1 duplica el tiempo de cada login.
# BCRYPT_COSTE=10
# Bloqueo por cuenta: fallos que lo activan (5) y tope en minutos (60).
# LOGIN_BLOQUEO_UMBRAL=5
# LOGIN_BLOQUEO_MAX_MINUTOS=60
# Usuarios protegidos ademas de @hehiachi y USER_ADMIN (lista por comas).
# USUARIOS_PROTEGIDOS=
# Bitacora: eventos en cola antes de descartar (10000).
# AUDITORIA_CAPACIDAD_COLA=10000
# Dashboard: TTL de la cache (120000 ms) y consultas en paralelo (4; 2 en prod).
# ANALITICA_CACHE_TTL_MS=120000
# ANALITICA_PARALELISMO=2
# Zona horaria de la JVM (America/Lima). La BD guarda UTC siempre.
# APP_ZONA_HORARIA=America/Lima
