# ============================================================
# Servidor publico: sirve el SPA de Angular y proxifica /api al
# backend Spring Boot (127.0.0.1:${BACKEND_PORT}, nunca publicado).
# Variables ${...} las resuelve envsubst en el arranque; las $var
# sin llaves son variables de nginx.
# ============================================================

# Protocolo original del cliente: Render termina TLS y envia
# X-Forwarded-Proto=https. Sin cabecera (curl local, healthcheck) => $scheme.
map $http_x_forwarded_proto $proto_cliente {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# HSTS y upgrade-insecure-requests solo cuando el cliente llego por HTTPS
# (en local por http://localhost no deben activarse).
map $proto_cliente $hsts {
    https   "max-age=31536000; includeSubDomains";
    default "";
}
map $proto_cliente $csp_upgrade {
    https   "; upgrade-insecure-requests";
    default "";
}

# Correlacion: reutiliza el X-Request-Id entrante si es seguro (charset y
# largo acotados, evita inyeccion en logs); si no, genera uno ($request_id).
map $http_x_request_id $req_id {
    default                          $request_id;
    "~^[A-Za-z0-9_-]{8,64}$"      $http_x_request_id;
}

# Host original CON puerto (p. ej. localhost:10000). $host lo pierde y Spring
# veria Origin http://localhost:10000 != http://localhost => "Invalid CORS
# request" en peticiones del propio SPA cuando no se usa el puerto 80/443.
map $http_host $host_original {
    default $http_host;
    ''      $host;
}

# Puerto original del cliente para X-Forwarded-Port: Tomcat (RemoteIpValve)
# fija 80/443 segun el proto si no lo recibe, y el Origin del propio SPA en
# un puerto no estandar dejaria de coincidir.
map $http_host $puerto_host {
    "~:(?<puerto>[0-9]+)$" $puerto;
    default                "";
}
map "$puerto_host:$proto_cliente" $puerto_original {
    "~^(?<puerto>[0-9]+):" $puerto;
    ":https"               443;
    default                80;
}

# Solo se pide "upgrade" cuando el cliente lo solicita (WebSocket); el resto
# reutiliza conexiones keep-alive hacia el backend.
map $http_upgrade $conexion_backend {
    default upgrade;
    ''      '';
}

# Los health checks de Render/Docker (cada pocos segundos) no ensucian el log.
map $uri $registrar_acceso {
    /api/health       0;
    /actuator/health  0;
    default           1;
}

# Log de acceso JSON en stdout, con request_id para cruzarlo con los logs del
# backend (MDC correlationId). Se registra $uri SIN query string (sin PII).
log_format json_acceso escape=json
    '{"ts":"$time_iso8601","origen":"nginx","request_id":"$req_id",'
    '"ip":"$remote_addr","metodo":"$request_method","ruta":"$uri",'
    '"estado":$status,"bytes":$body_bytes_sent,"duracion_s":$request_time,'
    '"upstream_s":"$upstream_response_time","proto":"$proto_cliente",'
    '"user_agent":"$http_user_agent","referer":"$http_referer"}';
access_log /dev/stdout json_acceso if=$registrar_acceso;

# Defensa en profundidad para el login (el backend tiene su propio limitador
# por IP). Generoso: 20/min por IP con rafaga de 10.
limit_req_zone $binary_remote_addr zone=login:1m rate=20r/m;
limit_req_status 429;

upstream backend {
    server 127.0.0.1:${BACKEND_PORT};
    keepalive 16;
}

server {
    listen ${PORT} default_server;
    listen [::]:${PORT} default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/plain text/css text/csv text/javascript application/javascript application/json application/xml image/svg+xml;

    # Metodos permitidos a nivel global; los estaticos se restringen mas abajo.
    if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$) {
        return 405;
    }

    # ---------------- API ----------------
    location ^~ /api/ {
        include /run/app/nginx/proxy-backend.conf;
    }

    location = /api/auth/login {
        limit_req zone=login burst=10 nodelay;
        include /run/app/nginx/proxy-backend.conf;
    }

    # ---------------- Actuator: solo health es publico ----------------
    # Ubicaciones exactas (=): tienen prioridad sobre el bloqueo ^~ /actuator.
    location = /actuator/health {
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405;
        }
        include /run/app/nginx/proxy-backend.conf;
    }
    location = /actuator/health/liveness {
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405;
        }
        include /run/app/nginx/proxy-backend.conf;
    }
    location = /actuator/health/readiness {
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405;
        }
        include /run/app/nginx/proxy-backend.conf;
    }

    location ^~ /actuator {
        include /run/app/nginx/headers-common.conf;
        return 404;
    }

    # Backend caido / arrancando: JSON con la misma forma que ApiResponse.
    location @backend_no_disponible {
        include /run/app/nginx/headers-common.conf;
        add_header Retry-After "10" always;
        add_header X-Request-Id $req_id always;
        default_type application/json;
        return 503 '{"exito":false,"mensaje":"Servicio no disponible temporalmente. Intenta de nuevo en unos segundos.","datos":null,"timestamp":"$time_iso8601"}';
    }

    # ---------------- SPA ----------------
    # Archivos ocultos (.git, .env, ...) nunca se sirven (salvo .well-known).
    location ~ /\.(?!well-known/) {
        include /run/app/nginx/headers-common.conf;
        return 404;
    }

    # JS/CSS llevan hash en el nombre (outputHashing=all): cache inmutable.
    location ~* \.(?:js|mjs|css|map)$ {
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405;
        }
        include /run/app/nginx/headers-spa.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Medios y fuentes: los de /media llevan hash; los de public/ (logo.png...)
    # no, asi que cache corta con revalidacion.
    location ~* \.(?:png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|eot)$ {
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405;
        }
        include /run/app/nginx/headers-spa.conf;
        add_header Cache-Control "public, max-age=86400, must-revalidate" always;
        try_files $uri =404;
    }

    # index.html nunca se cachea: cada deploy se ve al instante.
    location = /index.html {
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405;
        }
        include /run/app/nginx/headers-spa.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # Fallback del router de Angular.
    location / {
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405;
        }
        include /run/app/nginx/headers-spa.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri $uri/ /index.html;
    }
}
