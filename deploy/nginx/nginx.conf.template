# ============================================================
# nginx principal (se renderiza en el arranque con envsubst a
# /run/app/nginx/nginx.conf). Corre como usuario NO root: pid,
# temporales y config generada viven en /run/app (escribible).
# ============================================================
worker_processes ${NGINX_WORKER_PROCESSES};
pid /run/app/nginx/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    server_tokens off;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65s;
    client_header_timeout 15s;
    client_body_timeout 15s;
    send_timeout 30s;
    client_max_body_size 5m;

    client_body_temp_path /run/app/nginx/tmp/client_body;
    proxy_temp_path       /run/app/nginx/tmp/proxy;
    fastcgi_temp_path     /run/app/nginx/tmp/fastcgi;
    uwsgi_temp_path       /run/app/nginx/tmp/uwsgi;
    scgi_temp_path        /run/app/nginx/tmp/scgi;

    include /run/app/nginx/realip.conf;
    include /run/app/nginx/default.conf;
}
